{
  "name": "go-nl",
  "description": "vue application for the Genome of the Netherlands database",
  "version": "1.2.0",
  "scripts": {
    "copy-html:dev": "copyfiles -f ../rd-shared/templates/dev/index.html ./",
    "copy-html:prod": "copyfiles -f ../rd-shared/templates/build/index.html ./",
    "dev": "yarn copy-html:dev && vite",
    "build": "yarn copy-html:prod && vite build",
    "preview": "vite preview --port 9000",
    "pkg": "node ../rd-shared/js/zip.mjs",
    "format": "prettier src  --write --config ../.prettierrc.js",
    "checkFormat": "prettier src  --check --config ../.prettierrc.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "got": "^15.1.0",
    "marked": "^18.0.7",
    "rd-components": "0.1.0",
    "vue": "^3.2.41",
    "vue-router": "^4.1.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^3.1.2",
    "copyfiles": "^2.4.1",
    "eslint": "^8.22.0",
    "eslint-plugin-vue": "^9.3.0",
    "prettier": "^3.9.6",
    "vite": "^3.2.10",
    "vite-plugin-banner": "^0.6.1",
    "vite-plugin-generate-file": "^0.0.3"
  }
}
